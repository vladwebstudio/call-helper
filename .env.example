# Розпізнавання мови: local (whisper на цьому Mac, безкоштовно) | groq | custom
STT_PROVIDER=local
STT_LANGUAGE=uk

# local: шлях до whisper-bin (за замовчуванням ../Транскрипция/whisper-bin)
# WHISPER_DIR=
# WHISPER_MODEL=
# WHISPER_THREADS=6

# groq: ключ вставляє сам власник, не комітити
# GROQ_API_KEY=

# custom: будь-який OpenAI-сумісний /audio/transcriptions (напр. свій VPS)
# STT_URL=
# STT_KEY=
# STT_MODEL=whisper-large-v3-turbo
